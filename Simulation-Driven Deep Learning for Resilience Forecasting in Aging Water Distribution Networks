def run_simulation_task(task):
    """
    Simplified task runner - returns results without database writes
    Workers just compute and return - main process handles DB writes
    """
    global _WORKER_MONITOR
    
    worker_name = current_process().name
    
    try:
        # Mark worker as active
        if _WORKER_MONITOR is not None:
            _WORKER_MONITOR[worker_name] = 'active'
        
        start_time = time.time()
        
        network_file = task['network_file']
        year_offset = task['year_offset']
        rep_id = task['rep_id']
        failure_multiplier = task['failure_multiplier']
        config = task['config']
        
        # Run simulation - no DB access here!
        result = run_single_simulation(network_file, year_offset, rep_id, 
                                       failure_multiplier, config)
        
        if result:
            result['network_name'] = Path(network_file).stem
            result['replication'] = rep_id
            result['simulation_year'] = year_offset
            result['failure_multiplier'] = failure_multiplier
            result['timestamp'] = datetime.now().isoformat()
            result['process_id'] = current_process().name
            result['computation_time'] = time.time() - start_time
            result['status'] = 'completed'
        
        return result
        
    except Exception as e:
        return {
            'network_name': Path(task['network_file']).stem,
            'replication': task['rep_id'],
            'simulation_year': task['year_offset'],
            'failure_multiplier': task['failure_multiplier'],
            'status': 'failed',
            'timestamp': datetime.now().isoformat(),
            'process_id': current_process().name,
            'error': str(e)
        }
    finally:
        # Mark worker as idle
        if _WORKER_MONITOR is not None:
            _WORKER_MONITOR[worker_name] = 'idle'

class RealtimeNetworkAnalyzer:
    def __init__(self, config, num_workers=None):
        self.config = config
        self.setup_logging()
        
        # Default to cpu_count - 1 to leave one CPU for OS/main process
        if num_workers is None:
            detected_cpus = cpu_count()
            self.num_workers = max(1, detected_cpus - 1)
            self.logger.info(f"Auto-detected {detected_cpus} CPUs, using {self.num_workers} workers")
        else:
            self.num_workers = num_workers
            self.logger.info(f"Using {self.num_workers} worker(s) (user specified)")
        
        self.network_files = self.config['network_files']
        self.simulation_years = self.config['simulation']['years']
        self.replications = self.config['simulation']['replications']
        self.failure_multipliers = self.config['simulation']['failure_multipliers']
        
        self.time_settings = self.config['time_settings']
        self.hydraulic_settings = self.config['hydraulic']
        self.failure_params = self.config['failure']
        self.analysis_params = self.config['analysis']
        self.age_distribution = self.config['age_distribution']
        self.random_settings = self.config['random']
        self.output_settings = self.config['output']
        
        Path(self.output_settings['output_directory']).mkdir(parents=True, exist_ok=True)
        timestamp = datetime.now().strftime(self.output_settings['timestamp_format'])
        db_name = f"{self.output_settings['base_filename']}_{timestamp}.db"
        self.db_path = Path(self.output_settings['output_directory']) / db_name
        self.db_manager = RealtimeDatabaseManager(self.db_path)
        
        # Compute and save baseline cache to temporary file
        self.logger.info("="*60)
        self.logger.info("Pre-computing baseline simulations...")
        self.logger.info("="*60)
        self.baseline_cache = {}
        for network_file in self.network_files:
            network_name = Path(network_file).stem
            self.logger.info(f"  Computing baseline for {network_name}...")
            results_baseline, junction_names = run_baseline_simulation_once(
                network_file, self.time_settings, self.hydraulic_settings
            )
            if results_baseline is not None:
                self.baseline_cache[network_file] = {
                    'pressure': results_baseline.node['pressure'],
                    'demand': results_baseline.node['demand'],
                    'junction_names': junction_names
                }
                self.logger.info(f"  ✓ Baseline cached for {network_name}")
            else:
                self.logger.warning(f"  ✗ Failed to compute baseline for {network_name}")
        
        # Save baseline cache to temporary file for workers
        self.baseline_cache_file = Path(self.output_settings['output_directory']) / 'baseline_cache.pkl'
        with open(self.baseline_cache_file, 'wb') as f:
            pickle.dump(self.baseline_cache, f)
        self.logger.info(f"✓ Baseline cache saved to: {self.baseline_cache_file}")
        
        self.logger.info(f"Database file: {self.db_path}")
    
    def setup_logging(self):
        log_config = self.config.get('logging', {})
        log_level = getattr(logging, log_config.get('level', 'INFO'))
        
        handlers = [logging.StreamHandler()]
        
        if log_config.get('save_log', False):
            log_dir = Path(log_config.get('log_directory', 'logs'))
            log_dir.mkdir(parents=True, exist_ok=True)
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            log_file = log_dir / f'network_analysis_{timestamp}.log'
            handlers.append(logging.FileHandler(log_file))
        
        logging.basicConfig(
            level=log_level,
            format='%(asctime)s - %(levelname)s - %(message)s',
            handlers=handlers
        )
        self.logger = logging.getLogger(__name__)
    
    def create_tasks(self):
        """
        Create tasks WITHOUT baseline_data embedded in them
        """
        tasks = []
        
        for network_file in self.network_files:
            for rep in range(self.replications):
                for year in range(self.simulation_years):
                    for failure_mult in self.failure_multipliers:
                        task = {
                            'network_file': network_file,
                            'year_offset': year,
                            'rep_id': rep,
                            'failure_multiplier': failure_mult,
                            'config': self.config
                            # NO baseline_data here!
                        }
                        tasks.append(task)
        
        self.logger.info(f"Created {len(tasks)} tasks")
        return tasks
    
    def run_analysis(self):
        tasks = self.create_tasks()
        total_tasks = len(tasks)
        
        self.logger.info("="*60)
        self.logger.info(f"Starting analysis: {total_tasks} simulations")
        self.logger.info(f"Networks: {len(self.network_files)}")
        self.logger.info(f"Years: {self.simulation_years}, Replications: {self.replications}")
        self.logger.info(f"Workers: {self.num_workers}")
        self.logger.info(f"Results saving to: {self.db_path}")
        self.logger.info("="*60)
        
        start_time = time.time()
        completed = 0
        failed = 0
        
        # Create shared manager for worker monitoring
        manager = Manager()
        worker_monitor = manager.dict()
        
        # Use multiprocessing with baseline cache initialization
        with Pool(processes=self.num_workers, 
                  initializer=initialize_worker_baseline_cache,
                  initargs=(str(self.baseline_cache_file), worker_monitor)) as pool:
            
            # Submit ALL tasks at once - let workers grab them as they become available
            self.logger.info(f"Submitting {total_tasks} tasks to {self.num_workers} workers...")
            
            # Use imap_unordered with small chunksize for better load balancing
            # This processes results as they complete instead of waiting for all
            last_completed = 0
            check_count = 0
            last_check_time = time.time()
            
            for result in pool.imap_unordered(run_simulation_task, tasks, chunksize=1):
                # Immediately write result to database
                if result is not None and result.get('status') == 'completed':
                    success = self.db_manager.insert_result(result)
                    if success:
                        completed += 1
                    else:
                        failed += 1
                else:
                    failed += 1
                
                # Log progress every 10 seconds
                current_time = time.time()
                if current_time - last_check_time >= 10:
                    check_count += 1
                    
                    # Count active and idle workers
                    active_count = sum(1 for status in worker_monitor.values() if status == 'active')
                    idle_count = self.num_workers - active_count
                    
                    elapsed = current_time - start_time
                    avg_time = elapsed / completed if completed > 0 else 0
                    remaining = total_tasks - completed - failed
                    eta_minutes = (remaining * avg_time) / 60
                    
                    # Calculate throughput (sims per minute)
                    sims_completed_recently = completed - last_completed
                    throughput = (sims_completed_recently / (current_time - last_check_time)) * 60
                    last_completed = completed
                    last_check_time = current_time
                    
                    self.logger.info(
                        f"Progress: {completed}/{total_tasks} ({100*completed/total_tasks:.1f}%) | "
                        f"Workers: {active_count} active, {idle_count} idle | "
                        f"Throughput: {throughput:.1f} sims/min | "
                        f"Elapsed: {elapsed/60:.1f}m | ETA: {eta_minutes:.1f}m"
                    )
                    
                    # Show summary stats periodically (every 5 checks = ~50 seconds)
                    if check_count % 5 == 0 and completed > 50:
                        self.db_manager.finalize()  # Force flush buffer
                        stats = self.db_manager.get_summary_stats()
                        if not stats.empty:
                            self.logger.info(
                                f"  📊 Running Averages: Fails={stats['mean_failures'].iloc[0]:.1f}, "
                                f"WSA={stats['mean_water_service'].iloc[0]:.3f}, "
                                f"MRI={stats['mean_mri_system'].iloc[0]:.3f}, "
                                f"CPI={stats['mean_cpi'].iloc[0]:.3f}"
                            )
        
        self.db_manager.finalize()
        
        # Clean up baseline cache file
        try:
            self.baseline_cache_file.unlink()
            self.logger.info("✓ Cleaned up temporary baseline cache file")
        except:
            pass
        
        elapsed_time = time.time() - start_time
        
        self.logger.info("="*60)
        self.logger.info("ANALYSIS COMPLETE")
        self.logger.info("="*60)
        self.logger.info(f"Total time: {elapsed_time/60:.1f} minutes")
        self.logger.info(f"Successful: {completed}/{total_tasks}")
        
        summary = self.db_manager.get_summary_stats()
        if not summary.empty:
            self.logger.info("\nFinal Results:")
            self.logger.info(f"  Mean WSA: {summary['mean_water_service'].iloc[0]:.3f}")
            self.logger.info(f"  Worst WSA: {summary['worst_water_service'].iloc[0]:.3f}")
            self.logger.info(f"  Mean MRI: {summary['mean_mri_system'].iloc[0]:.3f}")
            self.logger.info(f"  Avg Failures: {summary['mean_failures'].iloc[0]:.2f}")
        
        self.logger.info(f"\nResults saved to: {self.db_path}")
        
        csv_path = self.db_path.with_suffix('.csv')
        self.logger.info(f"\nExporting to CSV: {csv_path}")
        self.db_manager.export_to_csv(csv_path)
        
        return self.db_path

