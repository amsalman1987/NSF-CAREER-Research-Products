def calculate_failure_probability(pipe_age, year_offset=0):
    """Literature-based failure probability with aging"""
    t = pipe_age + year_offset
    h0_t = 1e-4 * (2 - 0.1 * t + 0.002 * t**2)
    hazard_rate = h0_t * np.exp(4.41)
    annual_prob = 1 - np.exp(-hazard_rate)
    return min(annual_prob, 0.5)

def assign_pipe_ages(pipe_names, age_distribution, random_settings, rep_id):
    if random_settings['use_seed']:
        base_seed = random_settings['base_seed']
        seed = abs(base_seed + rep_id * 1000) % (2**32 - 1)
        np.random.seed(seed)
    
    age_ranges = list(age_distribution.keys())
    age_probs = np.array(list(age_distribution.values())) / 100.0
    
    num_pipes = len(pipe_names)
    if num_pipes == 0:
        return {}
    
    age_range_indices = np.random.choice(len(age_ranges), size=num_pipes, p=age_probs)
    
    ages = {}
    for i, pipe_name in enumerate(pipe_names):
        age_range = age_ranges[age_range_indices[i]]
        if 'greater than 50' in age_range or '>50' in age_range:
            ages[pipe_name] = np.random.uniform(50, 80)
        else:
            parts = age_range.replace('year', '').replace('to', ' ').split()
            min_age = float(parts[0])
            max_age = float(parts[1]) if len(parts) > 1 else min_age + 10
            ages[pipe_name] = np.random.uniform(min_age, max_age)
    
    return ages

def extract_comprehensive_features(wn, config):
    features = {}
    analysis_params = config['analysis']
    
    features['num_nodes'] = len(wn.node_name_list)
    features['num_links'] = len(wn.link_name_list)
    features['num_junctions'] = len(wn.junction_name_list)
    features['num_tanks'] = len(wn.tank_name_list)
    features['num_reservoirs'] = len(wn.reservoir_name_list)
    features['num_pumps'] = len(wn.pump_name_list)
    features['num_valves'] = len(wn.valve_name_list)
    
    if wn.pipe_name_list:
        pipe_data = []
        for name, pipe in wn.pipes():
            pipe_data.append({
                'diameter': pipe.diameter,
                'length': pipe.length,
                'roughness': pipe.roughness,
                'minor_loss': pipe.minor_loss,
                'volume': np.pi * (pipe.diameter/2)**2 * pipe.length
            })
        
        pipe_df = pd.DataFrame(pipe_data)
        
        features['avg_pipe_diameter'] = pipe_df['diameter'].mean()
        features['std_pipe_diameter'] = pipe_df['diameter'].std()
        features['min_pipe_diameter'] = pipe_df['diameter'].min()
        features['max_pipe_diameter'] = pipe_df['diameter'].max()
        features['diameter_range'] = pipe_df['diameter'].max() - pipe_df['diameter'].min()
        
        features['total_pipe_length'] = pipe_df['length'].sum()
        features['avg_pipe_length'] = pipe_df['length'].mean()
        features['std_pipe_length'] = pipe_df['length'].std()
        
        features['avg_pipe_roughness'] = pipe_df['roughness'].mean()
        features['std_pipe_roughness'] = pipe_df['roughness'].std()
        features['roughness_variability'] = (pipe_df['roughness'].std() / pipe_df['roughness'].mean() 
                                             if pipe_df['roughness'].mean() > 0 else 0)
        
        features['total_pipe_volume'] = pipe_df['volume'].sum()
        features['avg_pipe_volume'] = pipe_df['volume'].mean()
        
        small_threshold = analysis_params['small_pipe_threshold']
        medium_threshold = analysis_params['medium_pipe_threshold']
        features['num_small_pipes'] = len(pipe_df[pipe_df['diameter'] < small_threshold])
        features['num_medium_pipes'] = len(pipe_df[(pipe_df['diameter'] >= small_threshold) & 
                                                   (pipe_df['diameter'] < medium_threshold)])
        features['num_large_pipes'] = len(pipe_df[pipe_df['diameter'] >= medium_threshold])
        
        max_velocity = analysis_params['max_velocity']
        pipe_df['max_flow_capacity'] = max_velocity * np.pi * (pipe_df['diameter']/2)**2
        features['total_flow_capacity'] = pipe_df['max_flow_capacity'].sum()
        features['avg_flow_capacity'] = pipe_df['max_flow_capacity'].mean()
    else:
        for key in ['avg_pipe_diameter', 'std_pipe_diameter', 'min_pipe_diameter', 
                   'max_pipe_diameter', 'diameter_range', 'total_pipe_length',
                   'avg_pipe_length', 'std_pipe_length', 'avg_pipe_roughness',
                   'std_pipe_roughness', 'roughness_variability', 'total_pipe_volume',
                   'avg_pipe_volume', 'num_small_pipes', 'num_medium_pipes', 
                   'num_large_pipes', 'total_flow_capacity', 'avg_flow_capacity']:
            features[key] = 0
    
    try:
        expected_demand = wntr.metrics.hydraulic.expected_demand(wn).sum(axis=1)
        features['avg_demand'] = expected_demand.mean()
        features['peak_demand'] = expected_demand.max()
        features['demand_variability'] = expected_demand.std() / expected_demand.mean() if expected_demand.mean() > 0 else 0
    except:
        features['avg_demand'] = 0
        features['peak_demand'] = 0
        features['demand_variability'] = 0
    
    G = wn.to_graph()
    G_simple = nx.Graph(G.to_undirected())
    
    features['avg_degree'] = np.mean([d for n, d in G_simple.degree()])
    features['max_degree'] = max([d for n, d in G_simple.degree()]) if G_simple.degree() else 0
    
    try:
        features['avg_clustering'] = nx.average_clustering(G_simple)
    except:
        features['avg_clustering'] = 0
    
    try:
        features['algebraic_connectivity'] = nx.algebraic_connectivity(G_simple)
        spectrum = nx.laplacian_spectrum(G_simple)
        features['spectral_gap'] = spectrum[1] if len(spectrum) > 1 else 0
    except:
        features['algebraic_connectivity'] = 0
        features['spectral_gap'] = 0
    
    try:
        critical_pipes = wntr.metrics.topographic.bridges(G)
        features['num_critical_pipes'] = len(critical_pipes)
        features['critical_pipe_ratio'] = len(critical_pipes) / len(wn.pipe_name_list) if wn.pipe_name_list else 0
    except:
        features['num_critical_pipes'] = 0
        features['critical_pipe_ratio'] = 0
    
    try:
        if G_simple.number_of_nodes() > 5:
            features['meshedness_coefficient'] = ((G_simple.number_of_edges() - G_simple.number_of_nodes() + 1) / 
                                                 (2 * G_simple.number_of_nodes() - 5))
        else:
            features['meshedness_coefficient'] = 0
    except:
        features['meshedness_coefficient'] = 0
    
    try:
        valve_layer = []
        for valve_name in wn.valve_name_list:
            valve = wn.get_link(valve_name)
            valve_layer.append((valve.start_node_name, valve.end_node_name))
        
        if valve_layer:
            valve_segments = wntr.metrics.topographic.valve_segments(G, valve_layer=valve_layer)
            features['num_valve_segments'] = len(valve_segments)
        else:
            features['num_valve_segments'] = 0
    except:
        features['num_valve_segments'] = 0
    
    if G_simple.number_of_edges() > 0:
        try:
            edge_betweenness = nx.edge_betweenness_centrality(G_simple)
            betweenness_values = list(edge_betweenness.values())
            features['avg_pipe_betweenness'] = np.mean(betweenness_values)
            features['max_pipe_betweenness'] = np.max(betweenness_values)
            features['std_pipe_betweenness'] = np.std(betweenness_values)
        except:
            features['avg_pipe_betweenness'] = 0
            features['max_pipe_betweenness'] = 0
            features['std_pipe_betweenness'] = 0
    else:
        features['avg_pipe_betweenness'] = 0
        features['max_pipe_betweenness'] = 0
        features['std_pipe_betweenness'] = 0
    
    return features

def calculate_cpi(pressure_emergency, pressure_baseline, demand_emergency, demand_baseline, junction_names):
    try:
        N = len(junction_names)
        
        pressure_emerg_avg = pressure_emergency.loc[:, junction_names].mean(axis=0)
        pressure_base_avg = pressure_baseline.loc[:, junction_names].mean(axis=0)
        demand_emerg_avg = demand_emergency.loc[:, junction_names].mean(axis=0)
        demand_base_avg = demand_baseline.loc[:, junction_names].mean(axis=0)
        
        pressure_ratios = np.where(pressure_base_avg > 0, 
                                   pressure_emerg_avg / pressure_base_avg, 
                                   0)
        pressure_component = np.sum(pressure_ratios) / N
        
        demand_ratios = np.where(demand_base_avg > 0, 
                                demand_emerg_avg / demand_base_avg, 
                                0)
        demand_component = np.sum(demand_ratios) / N
        
        cpi = (pressure_component + demand_component) / 2
        
        return cpi
        
    except Exception as e:
        print(f"Error calculating CPI: {e}")
        return 0.0

def run_baseline_simulation_once(network_file, time_settings, hydraulic_settings):
    try:
        wn_baseline = wntr.network.WaterNetworkModel(network_file)
        
        duration_seconds = time_settings['duration_hours'] * 3600
        wn_baseline.options.time.duration = duration_seconds
        wn_baseline.options.time.hydraulic_timestep = time_settings['hydraulic_timestep']
        wn_baseline.options.time.report_timestep = time_settings['report_timestep']
        wn_baseline.options.hydraulic.required_pressure = hydraulic_settings['required_pressure']
        wn_baseline.options.hydraulic.minimum_pressure = hydraulic_settings['minimum_pressure']
        wn_baseline.options.hydraulic.demand_model = hydraulic_settings['demand_model']
        
        with SuppressOutput():
            sim_baseline = wntr.sim.WNTRSimulator(wn_baseline)
            results_baseline = sim_baseline.run_sim(solver_options={"MAXITER": 6000})
        
        return results_baseline, wn_baseline.junction_name_list
    except Exception as e:
        print(f"Baseline simulation error: {e}")
        return None, None

def run_single_simulation(network_file, year_offset, rep_id, failure_multiplier, config):
    """
    Run simulation using global baseline cache.
    No baseline_data parameter needed anymore!
    """
    global _BASELINE_CACHE
    
    try:
        time_settings = config['time_settings']
        hydraulic_settings = config['hydraulic']
        failure_params = config['failure']
        analysis_params = config['analysis']
        age_distribution = config['age_distribution']
        random_settings = config['random']
        
        # Get baseline from worker's cache
        baseline_data = _BASELINE_CACHE.get(network_file, None)
        
        wn = wntr.network.WaterNetworkModel(network_file)
        
        duration_seconds = time_settings['duration_hours'] * 3600
        wn.options.time.duration = duration_seconds
        wn.options.time.hydraulic_timestep = time_settings['hydraulic_timestep']
        wn.options.time.report_timestep = time_settings['report_timestep']
        wn.options.hydraulic.required_pressure = hydraulic_settings['required_pressure']
        wn.options.hydraulic.minimum_pressure = hydraulic_settings['minimum_pressure']
        wn.options.hydraulic.demand_model = hydraulic_settings['demand_model']
        
        if random_settings['use_seed']:
            base_seed = random_settings['base_seed']
            sim_seed = abs(hash(f"{network_file}_{rep_id}_{year_offset}_{failure_multiplier}") + base_seed) % (2**32 - 1)
            np.random.seed(sim_seed)
        
        pipe_ages = assign_pipe_ages(wn.pipe_name_list, age_distribution, random_settings, rep_id)
        
        G = wn.to_graph()
        try:
            critical_pipes = set(wntr.metrics.topographic.bridges(G))
        except:
            critical_pipes = set()
        
        failed_pipes_info = []
        total_leak_area = 0
        num_major = 0
        num_minor = 0
        durations = []
        
        for pipe_name in wn.pipe_name_list:
            pipe_age = pipe_ages.get(pipe_name, 30)
            
            failure_prob = calculate_failure_probability(pipe_age, year_offset) * failure_multiplier
            
            if np.random.random() < failure_prob:
                try:
                    pipe = wn.get_link(pipe_name)
                    
                    major_failure_ratio = failure_params['major_failure_ratio']
                    is_major = np.random.random() < major_failure_ratio
                    is_critical_pipe = pipe_name in critical_pipes
                    
                    if is_major:
                        if is_critical_pipe:
                            leak_size = 0.80
                        else:
                            leak_size = failure_params['major_leak_size']
                        
                        duration = np.random.uniform(
                            failure_params['major_duration_min'],
                            failure_params['major_duration_max']
                        )
                        num_major += 1
                    else:
                        if is_critical_pipe:
                            leak_size = 0.60
                        else:
                            leak_size = failure_params['minor_leak_size']
                        
                        duration = np.random.uniform(
                            failure_params['minor_duration_min'],
                            failure_params['minor_duration_max']
                        )
                        num_minor += 1
                    
                    leak_diameter = pipe.diameter * leak_size
                    leak_area = np.pi * (leak_diameter/2)**2
                    
                    start_time = np.random.uniform(1800, 7200)
                    end_time = min(start_time + (duration * 3600), duration_seconds)
                    
                    wn = wntr.morph.split_pipe(wn, pipe_name, f"{pipe_name}_B", f"{pipe_name}_leak")
                    leak_node = wn.get_node(f"{pipe_name}_leak")
                    leak_node.add_leak(wn, area=leak_area, start_time=start_time, end_time=end_time)
                    
                    failed_pipes_info.append(pipe_name)
                    total_leak_area += leak_area
                    durations.append(duration)
                        
                except Exception as e:
                    continue
        
        features = extract_comprehensive_features(wn, config)
        
        features['num_failed_pipes'] = len(failed_pipes_info)
        features['total_leak_area'] = total_leak_area
        features['avg_failure_duration'] = np.mean(durations) if durations else 0
        features['num_major_failures'] = num_major
        features['num_minor_failures'] = num_minor
        
        num_critical_failed = len([p for p in failed_pipes_info if p in critical_pipes])
        features['num_critical_failed'] = num_critical_failed
        
        if failed_pipes_info or np.random.random() < 0.1:
            with SuppressOutput():
                sim = wntr.sim.WNTRSimulator(wn)
                results = sim.run_sim(solver_options={"MAXITER": 6000})
            
            try:
                junction_names = baseline_data['junction_names'] if baseline_data else wn.junction_name_list
                
                expected_demand = wntr.metrics.hydraulic.expected_demand(wn)
                demand = results.node['demand'].loc[:, junction_names]
                expected_demand = expected_demand.iloc[:demand.shape[0]]
                
                wsa = wntr.metrics.water_service_availability(expected_demand, demand)
                wsa = wsa.clip(lower=0, upper=1).fillna(0)
                
                features['avg_water_service'] = wsa.mean().mean()
                features['min_water_service'] = wsa.min().min()
                
                pressure = results.node['pressure'].loc[:, junction_names]
                
                features['avg_pressure'] = pressure.mean().mean()
                
                pressure_threshold = analysis_params['pressure_threshold']
                features['pressure_deficit'] = ((pressure < pressure_threshold).sum().sum() / pressure.size).clip(0, 1)
                
                if baseline_data is not None:
                    pressure_baseline = baseline_data['pressure'].loc[:, junction_names]
                    demand_baseline = baseline_data['demand'].loc[:, junction_names]
                    
                    min_len = min(len(pressure), len(pressure_baseline))
                    pressure_bl = pressure_baseline.iloc[:min_len]
                    demand_bl = demand_baseline.iloc[:min_len]
                    pressure_em = pressure.iloc[:min_len]
                    demand_em = demand.iloc[:min_len]
                    
                    cpi_timeseries = []
                    for t in range(min_len):
                        cpi_t = calculate_cpi(
                            pressure_em.iloc[[t]], 
                            pressure_bl.iloc[[t]],
                            demand_em.iloc[[t]], 
                            demand_bl.iloc[[t]],
                            junction_names
                        )
                        cpi_timeseries.append(cpi_t)
                    
                    features['avg_cpi'] = np.mean(cpi_timeseries)
                    features['min_cpi'] = np.min(cpi_timeseries)
                else:
                    features['avg_cpi'] = 0
                    features['min_cpi'] = 0
                
                try:
                    elevation = pd.Series({name: wn.get_node(name).elevation 
                                         for name in junction_names})
                    
                    mri_per_junction = wntr.metrics.modified_resilience_index(
                        pressure=pressure,
                        elevation=elevation,
                        Pstar=pressure_threshold,
                        per_junction=True
                    )
                    
                    mri_system = wntr.metrics.modified_resilience_index(
                        pressure=pressure,
                        elevation=elevation,
                        Pstar=pressure_threshold,
                        demand=demand,
                        per_junction=False
                    )
                    
                    features['avg_mri_per_junction'] = mri_per_junction.mean().mean()
                    features['min_mri_per_junction'] = mri_per_junction.min().min()
                    features['avg_mri_system'] = mri_system.mean()
                    features['min_mri_system'] = mri_system.min()
                    
                except:
                    features['avg_mri_per_junction'] = 0
                    features['min_mri_per_junction'] = 0
                    features['avg_mri_system'] = 0
                    features['min_mri_system'] = 0
                
                try:
                    wn_original = wntr.network.WaterNetworkModel(network_file)
                    
                    all_original_nodes = wn_original.node_name_list
                    available_nodes = [n for n in all_original_nodes if n in results.node['head'].columns]
                    
                    head = results.node['head'].loc[:, available_nodes]
                    pressure_for_todini = results.node['pressure'].loc[:, available_nodes]
                    demand_for_todini = results.node['demand'].loc[:, available_nodes]
                    
                    original_link_names = wn_original.link_name_list
                    available_links = [link for link in original_link_names 
                                      if link in results.link['flowrate'].columns]
                    flowrate = results.link['flowrate'].loc[:, available_links]
                    
                    todini = wntr.metrics.todini_index(
                        head=head,
                        pressure=pressure_for_todini,
                        demand=demand_for_todini,
                        flowrate=flowrate,
                        wn=wn_original,
                        Pstar=pressure_threshold
                    )
                    features['avg_todini_index'] = todini.mean()
                    
                except Exception as e:
                    features['avg_todini_index'] = 0
                
                failure_impact = (1 - wsa.mean(axis=1)).clip(0, 1)
                features['max_failure_impact'] = failure_impact.max()
                features['avg_failure_impact'] = failure_impact.mean()
                
                impact_threshold = analysis_params['failure_impact_threshold']
                features['failure_duration'] = len(failure_impact[failure_impact > impact_threshold]) * (time_settings['report_timestep'] / 3600)
                
            except Exception as e:
                print(f"Metrics calculation error: {e}")
                features['avg_water_service'] = 0
                features['min_water_service'] = 0
                features['avg_pressure'] = 0
                features['pressure_deficit'] = 1
