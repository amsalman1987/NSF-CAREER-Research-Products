class WorkerMonitor:
    """Monitor worker activity in real-time"""
    def __init__(self):
        self.active_workers = set()
        self.lock = threading.Lock()
    
    def mark_worker_active(self, worker_id):
        with self.lock:
            self.active_workers.add(worker_id)
    
    def mark_worker_idle(self, worker_id):
        with self.lock:
            self.active_workers.discard(worker_id)
    
    def get_stats(self, total_workers):
        with self.lock:
            active = len(self.active_workers)
            idle = total_workers - active
            return active, idle

# Global worker monitor
_WORKER_MONITOR = None

class RealtimeDatabaseManager:
    def __init__(self, db_path):
        self.db_path = db_path
        self.lock = threading.Lock()
        self.results_buffer = []
        self.buffer_size = 50  # Increased from 20 for better efficiency
        
        self.columns = [
            'network_name', 'replication', 'simulation_year', 'failure_multiplier',
            'timestamp', 
            'num_nodes', 'num_links', 'num_junctions', 'num_tanks', 'num_reservoirs',
            'num_pumps', 'num_valves',
            'avg_pipe_diameter', 'std_pipe_diameter', 'min_pipe_diameter', 'max_pipe_diameter',
            'diameter_range', 'total_pipe_length', 'avg_pipe_length', 'std_pipe_length',
            'avg_pipe_roughness', 'std_pipe_roughness', 'roughness_variability',
            'total_pipe_volume', 'avg_pipe_volume', 'num_small_pipes', 'num_medium_pipes',
            'num_large_pipes', 'total_flow_capacity', 'avg_flow_capacity',
            'avg_demand', 'peak_demand', 'demand_variability',
            'avg_degree', 'max_degree', 'avg_clustering', 'algebraic_connectivity',
            'spectral_gap', 'meshedness_coefficient',
            'num_critical_pipes', 'critical_pipe_ratio', 'num_valve_segments',
            'avg_pipe_betweenness', 'max_pipe_betweenness', 'std_pipe_betweenness',
            'num_failed_pipes', 'total_leak_area', 'avg_failure_duration',
            'num_major_failures', 'num_minor_failures', 'num_critical_failed', 'failure_density',
            'critical_failure_ratio',
            'avg_water_service', 'min_water_service', 'avg_pressure', 'pressure_deficit',
            'avg_todini_index', 'max_failure_impact', 'avg_failure_impact',
            'failure_duration', 'avg_mri_per_junction', 'min_mri_per_junction',
            'avg_mri_system', 'min_mri_system', 'avg_cpi', 'min_cpi',
            'process_id', 'computation_time', 'status'
        ]
        
        self._initialize_database()
        
    def _initialize_database(self):
        """Create the database table with appropriate schema"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        column_defs = []
        for col in self.columns:
            if col in ['network_name', 'timestamp', 'process_id', 'status']:
                column_defs.append(f"{col} TEXT")
            elif col in ['replication', 'simulation_year', 'num_nodes', 'num_links', 
                        'num_junctions', 'num_tanks', 'num_reservoirs', 'num_pumps', 
                        'num_valves', 'num_small_pipes', 'num_medium_pipes', 
                        'num_large_pipes', 'num_critical_pipes', 'num_valve_segments',
                        'num_failed_pipes', 'num_major_failures', 'num_minor_failures',
                        'num_critical_failed']:
                column_defs.append(f"{col} INTEGER")
            else:
                column_defs.append(f"{col} REAL")
        
        create_table_sql = f"""
        CREATE TABLE IF NOT EXISTS simulations (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            {', '.join(column_defs)}
        )
        """
        
        cursor.execute(create_table_sql)
        
        # Create indexes for common queries
        cursor.execute("CREATE INDEX IF NOT EXISTS idx_network_name ON simulations(network_name)")
        cursor.execute("CREATE INDEX IF NOT EXISTS idx_status ON simulations(status)")
        cursor.execute("CREATE INDEX IF NOT EXISTS idx_sim_year ON simulations(simulation_year)")
        
        conn.commit()
        conn.close()
        
    def insert_result(self, result):
        """Insert a single result into the buffer"""
        with self.lock:
            try:
                self.results_buffer.append(result)
                if len(self.results_buffer) >= self.buffer_size:
                    self._flush_buffer()
                return True
            except Exception as e:
                print(f"Database insertion error: {e}")
                return False
    
    def _flush_buffer(self):
        """Write buffered results to database"""
        if not self.results_buffer:
            return
        
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            placeholders = ', '.join(['?' for _ in self.columns])
            insert_sql = f"INSERT INTO simulations ({', '.join(self.columns)}) VALUES ({placeholders})"
            
            rows = []
            for result in self.results_buffer:
                row = [result.get(col, None) for col in self.columns]
                rows.append(row)
            
            cursor.executemany(insert_sql, rows)
            conn.commit()
            conn.close()
            
            self.results_buffer = []
            
        except Exception as e:
            print(f"Error flushing buffer to database: {e}")
            traceback.print_exc()
    
    def finalize(self):
        """Flush any remaining buffered results"""
        with self.lock:
            self._flush_buffer()
    
    def get_summary_stats(self):
        """Get summary statistics from database"""
        try:
            conn = sqlite3.connect(self.db_path)
            
            query = """
            SELECT 
                COUNT(*) as total_simulations,
                AVG(avg_water_service) as mean_water_service,
                MIN(min_water_service) as worst_water_service,
                AVG(num_failed_pipes) as mean_failures,
                AVG(avg_todini_index) as mean_todini,
                AVG(avg_mri_system) as mean_mri_system,
                AVG(avg_cpi) as mean_cpi
            FROM simulations
            WHERE status = 'completed'
            """
            
            summary = pd.read_sql_query(query, conn)
            conn.close()
            
            return summary
            
        except Exception as e:
            print(f"Error reading database stats: {e}")
            return pd.DataFrame()
    
    def export_to_csv(self, csv_path):
        """Export database to CSV file"""
        try:
            conn = sqlite3.connect(self.db_path)
            df = pd.read_sql_query("SELECT * FROM simulations", conn)
            conn.close()
            
            df.to_csv(csv_path, index=False)
            print(f"✓ Database exported to CSV: {csv_path}")
            return True
        except Exception as e:
            print(f"Error exporting to CSV: {e}")
            return False

