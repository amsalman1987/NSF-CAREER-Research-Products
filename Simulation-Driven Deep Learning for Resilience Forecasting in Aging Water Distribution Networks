    print(f"\n✓ Using {len(available_features)} features")
    print(f"✓ Predicting {len(available_targets)} targets")
    
    train_df = df[df['simulation_year'].isin(train_years)].copy()
    test_df = df[df['simulation_year'].isin(test_years)].copy()
    
    print(f"\n✓ Train set: {len(train_df)} scenarios from ALL networks, years {train_years}")
    print(f"✓ Test set:  {len(test_df)} scenarios from ALL networks, years {test_years}")
    
    if len(train_df) == 0 or len(test_df) == 0:
        print("\n❌ ERROR: Not enough data for temporal split")
        return None
    
    X_train_full = train_df[available_features].values
    y_train_full = train_df[available_targets].values
    X_test = test_df[available_features].values
    y_test = test_df[available_targets].values
    
    train_networks = train_df['network_name'].values
    test_networks = test_df['network_name'].values
    test_years_array = test_df['simulation_year'].values
    
    X_train_full = np.nan_to_num(X_train_full, nan=0.0)
    y_train_full = np.nan_to_num(y_train_full, nan=0.0)
    X_test = np.nan_to_num(X_test, nan=0.0)
    y_test = np.nan_to_num(y_test, nan=0.0)
    
    val_years = [train_years[-2], train_years[-1]]
    actual_train_years = train_years[:-2]
    
    train_mask = train_df['simulation_year'].isin(actual_train_years).values
    val_mask = train_df['simulation_year'].isin(val_years).values
    
    X_train = X_train_full[train_mask]
    y_train = y_train_full[train_mask]
    X_val = X_train_full[val_mask]
    y_val = y_train_full[val_mask]
    
    print(f"\n✓ Actual train: {X_train.shape[0]} (years {actual_train_years})")
    print(f"✓ Validation: {X_val.shape[0]} (years {val_years})")
    print(f"✓ Future test: {X_test.shape[0]} (years {test_years})")
    
    scaler_X = RobustScaler()
    scaler_y = StandardScaler()
    
    X_train_scaled = scaler_X.fit_transform(X_train)
    y_train_scaled = scaler_y.fit_transform(y_train)
    
    X_val_scaled = scaler_X.transform(X_val)
    y_val_scaled = scaler_y.transform(y_val)
    
    X_test_scaled = scaler_X.transform(X_test)
    y_test_scaled = scaler_y.transform(y_test)
    
    print("✓ Data scaled")
    
    train_loader = DataLoader(
        TensorDataset(torch.FloatTensor(X_train_scaled), torch.FloatTensor(y_train_scaled)),
        batch_size=128, shuffle=True
    )
    val_loader = DataLoader(
        TensorDataset(torch.FloatTensor(X_val_scaled), torch.FloatTensor(y_val_scaled)),
        batch_size=128
    )
    test_loader = DataLoader(
        TensorDataset(torch.FloatTensor(X_test_scaled), torch.FloatTensor(y_test_scaled)),
        batch_size=128
    )
    
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    model = ResiliencePredictor(
        input_dim=X_train.shape[1],
        output_dim=y_train.shape[1],
        hidden_dims=[256, 128, 64],
        dropout=0.1
    ).to(device)
    
    print(f"\n✓ Model initialized: {sum(p.numel() for p in model.parameters()):,} parameters")
    print(f"✓ Device: {device}")
    
    print("\n" + "="*80)
    print("TRAINING ON ALL NETWORKS (PAST YEARS)")
    print("="*80)
    
    optimizer = optim.AdamW(model.parameters(), lr=0.002, weight_decay=1e-4)
    scheduler = optim.lr_scheduler.OneCycleLR(
        optimizer, max_lr=0.006, epochs=200, steps_per_epoch=len(train_loader),
        pct_start=0.1, div_factor=10, final_div_factor=100
    )
    
    mse_criterion = nn.MSELoss()
    huber_criterion = nn.SmoothL1Loss()
    
    best_val_r2 = -float('inf')
    best_model_state = None
    patience_counter = 0
    patience = 30
    
    train_losses, val_losses = [], []
    train_r2s, val_r2s = [], []
    learning_rates = []
    
    for epoch in range(200):
        model.train()
        train_loss = 0.0
        train_preds, train_targets = [], []
        epoch_lrs = []
        
        for X_batch, y_batch in train_loader:
            X_batch, y_batch = X_batch.to(device), y_batch.to(device)
            epoch_lrs.append(optimizer.param_groups[0]['lr'])
            
            optimizer.zero_grad()
            preds = model(X_batch)
            loss = 0.5 * mse_criterion(preds, y_batch) + 0.5 * huber_criterion(preds, y_batch)
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
            optimizer.step()
            scheduler.step()
            
            train_loss += loss.item()
            train_preds.append(preds.detach().cpu().numpy())
            train_targets.append(y_batch.cpu().numpy())
        
        train_loss /= len(train_loader)
        train_losses.append(train_loss)
        train_r2 = r2_score(np.vstack(train_targets).flatten(), np.vstack(train_preds).flatten())
        train_r2s.append(train_r2)
        learning_rates.extend(epoch_lrs)
        
        model.eval()
        val_loss = 0.0
        val_preds, val_targets = [], []
        
        with torch.no_grad():
            for X_batch, y_batch in val_loader:
                X_batch, y_batch = X_batch.to(device), y_batch.to(device)
                preds = model(X_batch)
                loss = 0.5 * mse_criterion(preds, y_batch) + 0.5 * huber_criterion(preds, y_batch)
                val_loss += loss.item()
                val_preds.append(preds.cpu().numpy())
                val_targets.append(y_batch.cpu().numpy())
        
        val_loss /= len(val_loader)
        val_losses.append(val_loss)
        val_r2 = r2_score(np.vstack(val_targets).flatten(), np.vstack(val_preds).flatten())
        val_r2s.append(val_r2)
        
        if val_r2 > best_val_r2:
            best_val_r2 = val_r2
            best_model_state = model.state_dict().copy()
            patience_counter = 0
        else:
            patience_counter += 1
        
        if (epoch + 1) % 20 == 0 or epoch < 5:
            print(f"Epoch [{epoch+1:3d}/200] | Train: R²={train_r2:.4f} Loss={train_loss:.6f} | "
                  f"Val: R²={val_r2:.4f} Loss={val_loss:.6f} | Best Val R²={best_val_r2:.4f} | No↑={patience_counter}")
        
        if patience_counter >= patience:
            print(f"\n✓ Early stopping at epoch {epoch+1}")
            break
    
    model.load_state_dict(best_model_state)
    print(f"\n✓ Best model loaded: Val R² = {best_val_r2:.4f}")
    
    print("\n" + "="*80)
    print(f"TESTING ON FUTURE YEARS {test_years} (ALL NETWORKS)")
    print("="*80)
    
    model.eval()
    all_preds, all_targets = [], []
    
    with torch.no_grad():
        for X_batch, y_batch in test_loader:
            X_batch = X_batch.to(device)
            preds = model(X_batch)
            all_preds.append(preds.cpu().numpy())
            all_targets.append(y_batch.cpu().numpy())
    
    predictions_scaled = np.vstack(all_preds)
    targets_scaled = np.vstack(all_targets)
    
    predictions = scaler_y.inverse_transform(predictions_scaled)
    targets = scaler_y.inverse_transform(targets_scaled)
    
    print("\n" + "="*80)
    print("OVERALL FUTURE YEAR PREDICTION PERFORMANCE (ALL NETWORKS)")
    print("="*80)
    
    results = {}
    for i, target_name in enumerate(available_targets):
        r2 = r2_score(targets[:, i], predictions[:, i])
        rmse = np.sqrt(mean_squared_error(targets[:, i], predictions[:, i]))
        mae = mean_absolute_error(targets[:, i], predictions[:, i])
        
        mask = targets[:, i] != 0
        mape = np.mean(np.abs((targets[mask, i] - predictions[mask, i]) / targets[mask, i])) * 100 if mask.sum() > 0 else 0
        
        results[target_name] = {
            'R2': r2, 'RMSE': rmse, 'MAE': mae, 'MAPE': mape,
            'actual_mean': targets[:, i].mean(),
            'pred_mean': predictions[:, i].mean(),
            'bias': predictions[:, i].mean() - targets[:, i].mean()
        }
        
        print(f"\n{target_name.replace('_', ' ').title()}:")
        print(f"  R² Score:        {r2:.4f}")
        print(f"  RMSE:            {rmse:.6f}")
        print(f"  MAE:             {mae:.6f}")
        print(f"  MAPE:            {mape:.2f}%")
    
    network_results = {}
    for network in networks:
        network_mask = test_networks == network
        if network_mask.sum() == 0:
            continue
        
        network_results[network] = {}
        for i, target_name in enumerate(available_targets):
            net_targets = targets[network_mask, i]
            net_preds = predictions[network_mask, i]
            
            r2 = r2_score(net_targets, net_preds)
            rmse = np.sqrt(mean_squared_error(net_targets, net_preds))
            mae = mean_absolute_error(net_targets, net_preds)
            
            mask = net_targets != 0
            mape = np.mean(np.abs((net_targets[mask] - net_preds[mask]) / net_targets[mask])) * 100 if mask.sum() > 0 else 0
            
            network_results[network][target_name] = {
                'R2': r2, 'RMSE': rmse, 'MAE': mae, 'MAPE': mape
            }
    
    results_df = pd.DataFrame({
        'metric': available_targets,
        'overall_r2': [results[t]['R2'] for t in available_targets],
        'overall_rmse': [results[t]['RMSE'] for t in available_targets],
        'overall_mae': [results[t]['MAE'] for t in available_targets],
        'overall_mape': [results[t]['MAPE'] for t in available_targets],
    })
    
    for network in networks:
        if network not in network_results:
            continue
        results_df[f'{network}_r2'] = [network_results[network][t]['R2'] for t in available_targets]
        results_df[f'{network}_mape'] = [network_results[network][t]['MAPE'] for t in available_targets]
    
    results_df.to_csv(Path(output_dir) / 'all_networks_temporal_results.csv', index=False)
    print(f"\n✓ Results saved to: {output_dir}/")
    
    return results, network_results, predictions, targets, model, test_networks


